/* Chestnut Studio — B站风格深色主题 */

/* ── 全局 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QWidget {
    background: #1a1a2e;
    color: #e4e4e7;
    font-size: 9pt;
}

QMainWindow {
    background: #1a1a2e;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #16162b;
    border: none;
    border-bottom: 1px solid #2a2a40;
    padding: 2px 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 14px;
    color: #a1a1aa;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QMenu {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    color: #c4c4d4;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #fb7299;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2a2a40;
    margin: 4px 10px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #16162b;
    border: none;
    border-top: 1px solid #2a2a40;
    color: #7a7a8a;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── 分割条 ── */
QSplitter::handle {
    background: #2a2a40;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* ── 播放器区域 ── */
#playerCard {
    background: #000000;
}

#videoHint {
    color: #52525b;
    font-size: 11pt;
    background: transparent;
}

/* ── 播放控制栏 ── */
#playerControls {
    background: #16162b;
    border-top: 1px solid #2a2a40;
}

#playerControls QPushButton {
    background: transparent;
    border: none;
    padding: 6px;
    border-radius: 4px;
    min-width: 32px;
    min-height: 32px;
}

#playerControls QPushButton:hover {
    background: rgba(255, 255, 255, 0.06);
}

#playerControls QPushButton:pressed {
    background: rgba(255, 255, 255, 0.03);
}

#playBtn {
    min-width: 36px;
    min-height: 36px;
}

#currentTime, #totalTime {
    color: #a1a1aa;
    font-size: 11pt;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    background: transparent;
}

/* 进度条 */
#seekSlider::groove:horizontal {
    background: #2a2a40;
    height: 4px;
    border-radius: 2px;
}

#seekSlider::handle:horizontal {
    background: #fb7299;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

#seekSlider::handle:horizontal:hover {
    background: #ff8cab;
    width: 16px;
    height: 16px;
    margin: -6px 0;
    border-radius: 8px;
}

#seekSlider::sub-page:horizontal {
    background: #fb7299;
    border-radius: 2px;
}

/* 音量滑块 */
#volumeSlider::groove:horizontal {
    background: #2a2a40;
    height: 3px;
    border-radius: 1.5px;
}

#volumeSlider::handle:horizontal {
    background: #e4e4e7;
    width: 10px;
    height: 10px;
    margin: -3.5px 0;
    border-radius: 5px;
}

#volumeSlider::handle:horizontal:hover {
    background: #fb7299;
}

#volumeSlider::sub-page:horizontal {
    background: #fb7299;
    border-radius: 1.5px;
}

/* 倍速下拉框 */
#rateCombo {
    background: transparent;
    border: 1px solid #2a2a40;
    border-radius: 4px;
    padding: 4px 8px;
    color: #a1a1aa;
    font-size: 10pt;
    min-height: 24px;
}

#rateCombo:hover {
    border-color: #fb7299;
    color: #ffffff;
}

#rateCombo::drop-down {
    border: none;
    width: 16px;
}

#rateCombo QAbstractItemView {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #c4c4d4;
    padding: 4px;
    outline: none;
}

/* ── 输入栏 ── */
#inputBar {
    background: #16162b;
    border-top: 1px solid #2a2a40;
}

/* 类型选择按钮 - 分段控件风格 */
#typeBtn_字幕, #typeBtn_画面 {
    background: transparent;
    border: 1px solid #2a2a40;
    color: #7a7a8a;
    padding: 6px 16px;
    font-size: 10pt;
    font-weight: 500;
    min-height: 28px;
}

#typeBtn_字幕 {
    border-radius: 4px 0 0 4px;
    border-right: none;
}

#typeBtn_画面 {
    border-radius: 0 4px 4px 0;
    border-left: none;
}

#typeBtn_字幕:checked, #typeBtn_画面:checked {
    background: #fb7299;
    border-color: #fb7299;
    color: #ffffff;
}

#typeBtn_字幕:hover:!checked, #typeBtn_画面:hover:!checked {
    color: #ffffff;
    border-color: #3a3a50;
}

/* 时间戳标签 */
#timeLabel {
    color: #fb7299;
    font-size: 11pt;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    background: transparent;
    padding: 0 4px;
}

/* 输入框 */
#noteInput {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e4e4e7;
    font-size: 10pt;
    min-height: 20px;
    selection-background-color: #fb7299;
}

#noteInput:focus {
    border-color: #fb7299;
}

#noteInput::placeholder {
    color: #52525b;
}

/* 发送按钮 */
#sendBtn {
    background: #fb7299;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    min-width: 36px;
    min-height: 32px;
}

#sendBtn:hover {
    background: #ff8cab;
}

#sendBtn:pressed {
    background: #e06080;
}

/* ── 笔记列表面板 ── */
#notePanel {
    background: #16162b;
    border-left: 1px solid #2a2a40;
}

#notePanelTitle {
    background: #16162b;
    border-bottom: 1px solid #2a2a40;
}

#notePanelTitleText {
    color: #e4e4e7;
    font-size: 11pt;
    font-weight: 600;
    background: transparent;
}

#notePanelCount {
    color: #7a7a8a;
    font-size: 9pt;
    background: #2a2a40;
    border-radius: 8px;
    padding: 1px 8px;
    min-width: 16px;
}

#clearBtn {
    background: transparent;
    border: 1px solid #2a2a40;
    border-radius: 4px;
    color: #7a7a8a;
    font-size: 9pt;
    padding: 2px 10px;
    min-height: 22px;
}

#clearBtn:hover {
    border-color: #ef4444;
    color: #ef4444;
}

/* 笔记列表 */
#noteList {
    background: transparent;
    border: none;
    outline: none;
}

#noteList::item {
    background: transparent;
    border: none;
    padding: 0;
}

#noteList::item:selected {
    background: rgba(251, 114, 153, 0.1);
}

/* 笔记分组标题 */
#noteGroupLabel {
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
    padding: 2px 0;
}

/* 笔记条目 */
#noteTime {
    color: #fb7299;
    font-size: 10pt;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    background: transparent;
}

#noteText {
    color: #c4c4d4;
    font-size: 10pt;
    background: transparent;
    line-height: 1.4;
}

/* 空状态提示 */
#noteEmptyLabel {
    color: #52525b;
    font-size: 10pt;
    background: transparent;
    padding: 40px 20px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 6px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #2a2a40;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3a50;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 6px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #2a2a40;
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3a50;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── 下拉框（通用） ── */
QComboBox {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e4e4e7;
}

QComboBox:hover {
    border-color: #3a3a50;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #c4c4d4;
    padding: 4px;
}

/* ── 工具提示 ── */
QToolTip {
    background: #1e1e36;
    border: 1px solid #2a2a40;
    border-radius: 4px;
    padding: 6px 10px;
    color: #e4e4e7;
    font-size: 9pt;
}
