/* Chestnut Studio — 设计系统 v2
 *
 * 设计决策：
 * - 色彩：中性深色底（非蓝紫色），通过灰度层次区分表面层级
 * - 强调色：Bilibili 粉 #fb7299，克制使用（仅按钮/选中态/时间戳）
 * - 间距：8px 基准网格 (8/16/24/32)
 * - 圆角：统一 6px，小控件 4px
 * - 边框：细线 1px，用于表面区分而非装饰
 * - 字体：系统字体，时间数字等高
 *
 * 表面层级（从低到高）：
 *   0 — 背景       #0a0a0a
 *   1 — 面板       #141414
 *   2 — 控件       #1e1e1e
 *   3 — 输入框     #282828
 *   4 — 悬浮态     rgba(255,255,255,0.08)
 */

/* ── 全局 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", -apple-system, sans-serif;
}

QWidget {
    background: #0a0a0a;
    color: #e8e8ea;
    font-size: 9pt;
}

QMainWindow {
    background: #0a0a0a;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #0a0a0a;
    border-bottom: 1px solid #1a1a1a;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    color: #888;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 0.08);
    color: #f0f0f0;
}

QMenu {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    color: #ccc;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #fb7299;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2a2a2a;
    margin: 4px 10px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    color: #666;
    font-size: 8pt;
    padding: 1px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── 分割条 ── */
QSplitter::handle {
    background: #1a1a1a;
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* ── 播放器区域 ── */
#playerCard {
    background: #000000;
}

#videoHint {
    color: #444;
    font-size: 11pt;
    background: transparent;
}

/* ── 播放控制栏 ── */
#playerControls {
    background: #0d0d0d;
    border-top: 1px solid #1a1a1a;
    padding: 0 8px;
}

#playerControls QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
}

#playerControls QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}

#playerControls QPushButton:pressed {
    background: rgba(255, 255, 255, 0.04);
}

#playBtn {
    min-width: 36px;
    min-height: 36px;
}

#playBtn:hover {
    background: rgba(251, 114, 153, 0.15);
}

/* 时间标签 */
#currentTime, #totalTime {
    color: #888;
    font-size: 11pt;
    font-weight: 500;
    background: transparent;
    letter-spacing: 0.5px;
}

/* 进度条 · 薄线风格 */
#seekSlider::groove:horizontal {
    background: #2a2a2a;
    height: 2px;
    border-radius: 1px;
}

#seekSlider::handle:horizontal {
    background: #fb7299;
    width: 12px;
    height: 12px;
    margin: -5px 0;
    border-radius: 6px;
    box-shadow: 0 0 4px rgba(251, 114, 153, 0.3);
}

#seekSlider::handle:horizontal:hover {
    background: #ff8cab;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

#seekSlider::sub-page:horizontal {
    background: #fb7299;
    border-radius: 1px;
}

/* 音量滑块 */
#volumeSlider::groove:horizontal {
    background: #2a2a2a;
    height: 2px;
    border-radius: 1px;
}

#volumeSlider::handle:horizontal {
    background: #e8e8ea;
    width: 10px;
    height: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

#volumeSlider::handle:horizontal:hover {
    background: #fb7299;
}

#volumeSlider::sub-page:horizontal {
    background: #888;
    border-radius: 1px;
}

/* 倍速下拉框 */
#rateCombo {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 2px 6px;
    color: #888;
    font-size: 9pt;
    min-height: 24px;
}

#rateCombo:hover {
    border-color: #fb7299;
    color: #f0f0f0;
}

#rateCombo::drop-down {
    border: none;
    width: 12px;
}

#rateCombo::down-arrow {
    image: none;
}

#rateCombo QAbstractItemView {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #ccc;
    padding: 4px;
    outline: none;
}

/* ── 输入栏 ── */
#inputBar {
    background: #0d0d0d;
    border-top: 1px solid #1a1a1a;
    padding: 8px 12px;
}

/* 类型选择按钮 */
#typeBtn_字幕, #typeBtn_画面 {
    background: transparent;
    border: 1px solid #2a2a2a;
    color: #666;
    padding: 5px 14px;
    font-size: 9pt;
    font-weight: 500;
    min-height: 28px;
}

#typeBtn_字幕 {
    border-radius: 4px 0 0 4px;
    border-right: none;
}

#typeBtn_画面 {
    border-radius: 0 4px 4px 0;
    border-left: none;
}

#typeBtn_字幕:checked, #typeBtn_画面:checked {
    background: #fb7299;
    border-color: #fb7299;
    color: #ffffff;
}

#typeBtn_字幕:hover:!checked, #typeBtn_画面:hover:!checked {
    color: #ccc;
    border-color: #3a3a3a;
}

/* 时间戳标签 */
#timeLabel {
    color: #fb7299;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
    padding: 0 8px;
    letter-spacing: 0.5px;
}

/* 输入框 */
#noteInput {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    padding: 7px 12px;
    color: #f0f0f0;
    font-size: 10pt;
    min-height: 20px;
    selection-background-color: #fb7299;
}

#noteInput:focus {
    border-color: #fb7299;
}

#noteInput::placeholder {
    color: #555;
}

/* 发送按钮 */
#sendBtn {
    background: #fb7299;
    border: none;
    border-radius: 6px;
    padding: 6px 14px;
    min-width: 36px;
    min-height: 32px;
}

#sendBtn:hover {
    background: #ff8cab;
}

#sendBtn:pressed {
    background: #e06080;
}

/* ── 笔记列表面板 ── */
#notePanel {
    background: #0d0d0d;
    border-left: 1px solid #1a1a1a;
}

#notePanelTitle {
    background: #111111;
    border-bottom: 1px solid #1a1a1a;
    padding: 10px 12px;
}

#notePanelTitleText {
    color: #f0f0f0;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
}

#notePanelCount {
    color: #888;
    font-size: 8pt;
    background: #1e1e1e;
    border-radius: 8px;
    padding: 1px 7px;
    min-width: 14px;
}

#clearBtn {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    color: #666;
    font-size: 8pt;
    padding: 2px 8px;
    min-height: 22px;
}

#clearBtn:hover {
    border-color: #ef4444;
    color: #ef4444;
}

/* 笔记列表 */
#noteList {
    background: transparent;
    border: none;
    outline: none;
}

#noteList::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    padding: 2px 0;
}

#noteList::item:selected {
    background: rgba(251, 114, 153, 0.08);
}

/* 笔记分组标题 */
#noteGroupLabel {
    font-size: 8pt;
    font-weight: 600;
    background: transparent;
    padding: 6px 12px 2px;
    letter-spacing: 1px;
}

/* 笔记条目控件 */
#noteTime {
    color: #fb7299;
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
    letter-spacing: 0.5px;
}

#noteText {
    color: #ccc;
    font-size: 9pt;
    background: transparent;
    line-height: 1.3;
}

/* 空状态提示 */
#noteEmptyLabel {
    color: #555;
    font-size: 10pt;
    background: transparent;
    padding: 32px 16px;
}

/* ── 滚动条 · 窄/半透明 ── */
QScrollBar:vertical {
    background: transparent;
    width: 4px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.1);
    min-height: 24px;
    border-radius: 2px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.2);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ── 下拉框 ── */
QComboBox {
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e8e8ea;
}

QComboBox:hover {
    border-color: #3a3a3a;
}

QComboBox::drop-down {
    border: none;
    width: 16px;
}

QComboBox QAbstractItemView {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #ccc;
    padding: 4px;
}

/* ── 工具提示 ── */
QToolTip {
    background: #141414;
    border: 1px solid #2a2a2a;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e8e8ea;
    font-size: 9pt;
}
