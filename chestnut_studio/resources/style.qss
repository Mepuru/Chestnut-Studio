/* Chestnut Studio — 现代暗色主题 */

/* ── 全局 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", -apple-system, sans-serif;
}

QWidget {
    background: #0e0e10;
    color: #e8e8ea;
    font-size: 9pt;
}

QMainWindow {
    background: #0e0e10;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #141416;
    border-bottom: 1px solid #1f1f23;
    padding: 2px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 12px;
    color: #a0a0a8;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 0.06);
    color: #ffffff;
}

QMenu {
    background: #18181b;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 7px 20px;
    color: #c8c8cc;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #fb7299;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2a2a2e;
    margin: 4px 8px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #141416;
    border-top: 1px solid #1f1f23;
    color: #6e6e76;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

/* ── 分割条 ── */
QSplitter::handle {
    background: #1f1f23;
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* ── 播放器区域 ── */
#playerCard {
    background: #000000;
}

#videoHint {
    color: #52525b;
    font-size: 11pt;
    background: transparent;
}

/* ── 播放控制栏 ── */
#playerControls {
    background: #141416;
    border-top: 1px solid #1f1f23;
    padding: 2px 0;
}

#playerControls QPushButton {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 4px;
    min-width: 30px;
    min-height: 30px;
}

#playerControls QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}

#playerControls QPushButton:pressed {
    background: rgba(255, 255, 255, 0.04);
}

#playBtn {
    min-width: 34px;
    min-height: 34px;
}

/* 时间标签 */
#currentTime, #totalTime {
    color: #a0a0a8;
    font-size: 11pt;
    font-weight: 500;
    background: transparent;
}

/* 进度条 */
#seekSlider::groove:horizontal {
    background: #2a2a2e;
    height: 3px;
    border-radius: 1.5px;
}

#seekSlider::handle:horizontal {
    background: #fb7299;
    width: 12px;
    height: 12px;
    margin: -4.5px 0;
    border-radius: 6px;
}

#seekSlider::handle:horizontal:hover {
    background: #ff8cab;
    width: 14px;
    height: 14px;
    margin: -5.5px 0;
    border-radius: 7px;
}

#seekSlider::sub-page:horizontal {
    background: #fb7299;
    border-radius: 1.5px;
}

/* 音量滑块 */
#volumeSlider::groove:horizontal {
    background: #2a2a2e;
    height: 3px;
    border-radius: 1.5px;
}

#volumeSlider::handle:horizontal {
    background: #e8e8ea;
    width: 10px;
    height: 10px;
    margin: -3.5px 0;
    border-radius: 5px;
}

#volumeSlider::handle:horizontal:hover {
    background: #fb7299;
}

#volumeSlider::sub-page:horizontal {
    background: #e8e8ea;
    border-radius: 1.5px;
}

/* 倍速下拉框 */
#rateCombo {
    background: transparent;
    border: 1px solid #2a2a2e;
    border-radius: 4px;
    padding: 3px 6px;
    color: #a0a0a8;
    font-size: 10pt;
    min-height: 22px;
}

#rateCombo:hover {
    border-color: #fb7299;
    color: #ffffff;
}

#rateCombo::drop-down {
    border: none;
    width: 14px;
}

#rateCombo QAbstractItemView {
    background: #18181b;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #c8c8cc;
    padding: 4px;
    outline: none;
}

/* ── 输入栏 ── */
#inputBar {
    background: #141416;
    border-top: 1px solid #1f1f23;
    padding: 6px 0;
}

/* 类型选择按钮 */
#typeBtn_字幕, #typeBtn_画面 {
    background: transparent;
    border: 1px solid #2a2a2e;
    color: #6e6e76;
    padding: 5px 14px;
    font-size: 10pt;
    font-weight: 500;
    min-height: 26px;
}

#typeBtn_字幕 {
    border-radius: 4px 0 0 4px;
    border-right: none;
}

#typeBtn_画面 {
    border-radius: 0 4px 4px 0;
    border-left: none;
}

#typeBtn_字幕:checked, #typeBtn_画面:checked {
    background: #fb7299;
    border-color: #fb7299;
    color: #ffffff;
}

#typeBtn_字幕:hover:!checked, #typeBtn_画面:hover:!checked {
    color: #c8c8cc;
    border-color: #3a3a3e;
}

/* 时间戳标签 */
#timeLabel {
    color: #fb7299;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
    padding: 0 4px;
}

/* 输入框 */
#noteInput {
    background: #1a1a1e;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    padding: 7px 12px;
    color: #e8e8ea;
    font-size: 10pt;
    min-height: 18px;
    selection-background-color: #fb7299;
}

#noteInput:focus {
    border-color: #fb7299;
}

#noteInput::placeholder {
    color: #52525b;
}

/* 发送按钮 */
#sendBtn {
    background: #fb7299;
    border: none;
    border-radius: 6px;
    padding: 5px 12px;
    min-width: 34px;
    min-height: 30px;
}

#sendBtn:hover {
    background: #ff8cab;
}

#sendBtn:pressed {
    background: #e06080;
}

/* ── 笔记列表面板 ── */
#notePanel {
    background: #111113;
    border-left: 1px solid #1f1f23;
}

#notePanelTitle {
    background: #141416;
    border-bottom: 1px solid #1f1f23;
    padding: 6px 0;
}

#notePanelTitleText {
    color: #e8e8ea;
    font-size: 11pt;
    font-weight: 600;
    background: transparent;
}

#notePanelCount {
    color: #6e6e76;
    font-size: 8pt;
    background: #1f1f23;
    border-radius: 8px;
    padding: 1px 7px;
    min-width: 14px;
}

#clearBtn {
    background: transparent;
    border: 1px solid #2a2a2e;
    border-radius: 4px;
    color: #6e6e76;
    font-size: 8pt;
    padding: 2px 8px;
    min-height: 20px;
}

#clearBtn:hover {
    border-color: #ef4444;
    color: #ef4444;
}

/* 笔记列表 */
#noteList {
    background: transparent;
    border: none;
    outline: none;
}

#noteList::item {
    background: transparent;
    border: none;
    padding: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}

#noteList::item:selected {
    background: rgba(251, 114, 153, 0.08);
}

#noteList::item:hover {
    background: rgba(255, 255, 255, 0.03);
}

/* 笔记分组标题 */
#noteGroupLabel {
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
    padding: 4px 0 2px;
}

/* 笔记条目 */
#noteTime {
    color: #fb7299;
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
}

#noteText {
    color: #c8c8cc;
    font-size: 9pt;
    background: transparent;
    line-height: 1.3;
}

/* 空状态提示 */
#noteEmptyLabel {
    color: #52525b;
    font-size: 10pt;
    background: transparent;
    padding: 30px 16px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #2a2a2e;
    min-height: 28px;
    border-radius: 2.5px;
}

QScrollBar::handle:vertical:hover {
    background: #3a3a3e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 5px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #2a2a2e;
    min-width: 28px;
    border-radius: 2.5px;
}

QScrollBar::handle:horizontal:hover {
    background: #3a3a3e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* ── 下拉框 ── */
QComboBox {
    background: #1a1a1e;
    border: 1px solid #2a2a2e;
    border-radius: 4px;
    padding: 4px 8px;
    color: #e8e8ea;
}

QComboBox:hover {
    border-color: #3a3a3e;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #18181b;
    border: 1px solid #2a2a2e;
    border-radius: 6px;
    selection-background-color: #fb7299;
    selection-color: #ffffff;
    color: #c8c8cc;
    padding: 4px;
}

/* ── 工具提示 ── */
QToolTip {
    background: #18181b;
    border: 1px solid #2a2a2e;
    border-radius: 4px;
    padding: 5px 8px;
    color: #e8e8ea;
    font-size: 9pt;
}
