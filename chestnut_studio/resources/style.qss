/* Chestnut Studio — 简洁青春主题
 *
 * 设计原则：干净、轻量、呼吸感
 * 色彩：柔和深色底 + 粉紫强调色 + 大面积留白
 * 按钮：正常平板按钮，无过度装饰
 * 圆角：统一 8px 大圆角，亲和力强
 */

/* ── 全局 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", -apple-system, sans-serif;
}

QWidget {
    background: #1a1a2e;
    color: #e0e0f0;
    font-size: 9pt;
}

QMainWindow {
    background: #1a1a2e;
}

/* ── 菜单栏 ── */
QMenuBar {
    background: #16162b;
    border-bottom: 1px solid #25254a;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    color: #9090b0;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

QMenu {
    background: #1e1e38;
    border: 1px solid #2e2e50;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    color: #c0c0d8;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #7c5cfc;
    color: #ffffff;
}

QMenu::separator {
    height: 1px;
    background: #2e2e50;
    margin: 4px 10px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: #16162b;
    border-top: 1px solid #25254a;
    color: #7070a0;
    font-size: 8pt;
    padding: 1px 4px;
}

QStatusBar::item {
    border: none;
}

#versionLabel {
    color: #505080;
    font-size: 8pt;
    padding: 0 6px;
    background: transparent;
}

/* ── 分割条 ── */
QSplitter::handle {
    background: #25254a;
}

QSplitter::handle:horizontal {
    width: 2px;
}

/* ── 播放器区域 ── */
#playerCard {
    background: #000000;
}

#videoHint {
    color: #505068;
    font-size: 11pt;
    background: transparent;
}

/* ── 播放控制栏 ── */
#playerControls {
    background: #14142a;
    border-top: 1px solid #25254a;
}

#playerControls QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    min-width: 30px;
    min-height: 30px;
}

#playerControls QPushButton:hover {
    background: rgba(255, 255, 255, 0.08);
}

#playerControls QPushButton:pressed {
    background: rgba(255, 255, 255, 0.04);
}

#playBtn {
    min-width: 32px;
    min-height: 32px;
}

#playBtn:hover {
    background: rgba(124, 92, 252, 0.15);
}

#currentTime, #totalTime {
    color: #8080b0;
    font-size: 10pt;
    font-weight: 500;
    background: transparent;
    letter-spacing: 0.3px;
}

/* 进度条 */
#seekSlider::groove:horizontal {
    background: #2e2e50;
    height: 4px;
    border-radius: 2px;
}

#seekSlider::handle:horizontal {
    background: #7c5cfc;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

#seekSlider::handle:horizontal:hover {
    background: #9b7cff;
}

#seekSlider::sub-page:horizontal {
    background: #7c5cfc;
    border-radius: 2px;
}

/* 音量滑块 */
#volumeSlider::groove:horizontal {
    background: #2e2e50;
    height: 4px;
    border-radius: 2px;
}

#volumeSlider::handle:horizontal {
    background: #e0e0f0;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

#volumeSlider::handle:horizontal:hover {
    background: #7c5cfc;
}

#volumeSlider::sub-page:horizontal {
    background: #7c5cfc;
    border-radius: 2px;
}

/* 倍速下拉框 */
#rateCombo {
    background: #1e1e38;
    border: 1px solid #2e2e50;
    border-radius: 6px;
    padding: 2px 8px;
    color: #9090b0;
    font-size: 9pt;
    min-height: 26px;
}

#rateCombo:hover {
    border-color: #7c5cfc;
    color: #ffffff;
}

#rateCombo::drop-down {
    border: none;
    width: 14px;
}

#rateCombo QAbstractItemView {
    background: #1e1e38;
    border: 1px solid #2e2e50;
    border-radius: 8px;
    selection-background-color: #7c5cfc;
    selection-color: #ffffff;
    color: #c0c0d8;
    padding: 4px;
    outline: none;
}

/* ── 左侧面板（播放器 + 输入栏） ── */
#leftPane {
    background: transparent;
}

/* ── 输入栏 ── */
#inputBar {
    background: #14142a;
    border-top: 1px solid #25254a;
}

#colorDot {
    min-width: 10px;
    min-height: 10px;
    max-width: 10px;
    max-height: 10px;
    border-radius: 5px;
}

#trackLabel {
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
}

#noteInput {
    background: #1e1e38;
    border: 1px solid #2e2e50;
    border-radius: 8px;
    padding: 7px 14px;
    color: #e0e0f0;
    font-size: 10pt;
    min-height: 20px;
    selection-background-color: #7c5cfc;
}

#noteInput:focus {
    border-color: #7c5cfc;
}

#noteInput::placeholder {
    color: #505080;
}

#timeLabel {
    color: #7c5cfc;
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
    padding: 0 4px;
}

#termBtn {
    background: transparent;
    border: 1px solid #2e2e50;
    border-radius: 6px;
    color: #9090b0;
    font-size: 9pt;
    padding: 6px 12px;
    min-height: 28px;
}

#termBtn:hover {
    border-color: #7c5cfc;
    color: #e0e0f0;
}

#sendBtn {
    background: #7c5cfc;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 10pt;
    font-weight: 500;
    min-height: 30px;
}

#sendBtn:hover {
    background: #9b7cff;
}

#sendBtn:pressed {
    background: #6a4ad8;
}

/* ── 笔记列表面板 ── */
#notePanel {
    background: #14142a;
    border-left: 2px solid #25254a;
}

#notePanelTitle {
    background: #16162b;
    border-bottom: 1px solid #25254a;
    padding: 10px 14px;
}

#notePanelTitleText {
    color: #e0e0f0;
    font-size: 11pt;
    font-weight: 600;
    background: transparent;
}

#notePanelCount {
    color: #7070a0;
    font-size: 8pt;
    background: #25254a;
    border-radius: 8px;
    padding: 1px 7px;
    min-width: 14px;
}

#clearBtn {
    background: transparent;
    border: 1px solid #2e2e50;
    border-radius: 6px;
    color: #7070a0;
    font-size: 8pt;
    padding: 3px 10px;
    min-height: 22px;
}

#clearBtn:hover {
    border-color: #f05060;
    color: #f05060;
}

/* 笔记列表 */
#noteList {
    background: transparent;
    border: none;
    outline: none;
}

#noteList::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    padding: 2px 0;
}

#noteList::item:selected {
    background: rgba(124, 92, 252, 0.1);
}

#noteList::item:hover {
    background: rgba(255, 255, 255, 0.03);
}

#noteGroupLabel {
    font-size: 8pt;
    font-weight: 600;
    background: transparent;
    padding: 6px 14px 2px;
    letter-spacing: 1px;
}

#noteId {
    color: #505080;
    font-size: 8pt;
    font-weight: 500;
    background: transparent;
}

#noteTime {
    color: #7c5cfc;
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
}

#noteText {
    color: #c0c0d8;
    font-size: 9pt;
    background: transparent;
    line-height: 1.3;
}

#noteEmptyLabel {
    color: #505080;
    font-size: 10pt;
    background: transparent;
    padding: 32px 16px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border: none;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.1);
    min-height: 24px;
    border-radius: 2.5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.2);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ── 快捷键对话框 ── */
#shortcutDialog {
    background: #1a1a2e;
}

#shortcutDialog QTableWidget {
    background: #1a1a2e;
    border: none;
    color: #e0e0f0;
    font-size: 10pt;
    outline: none;
}

#shortcutDialog QTableWidget::item {
    padding: 6px 12px;
    border: none;
}

#shortcutDialog QTableWidget::item:selected {
    background: rgba(124, 92, 252, 0.15);
}

#shortcutDialog QHeaderView::section {
    background: #16162b;
    border: none;
    border-bottom: 1px solid #25254a;
    padding: 8px 12px;
    color: #9090b0;
    font-weight: 600;
}

/* ── 工具提示 ── */
QToolTip {
    background: #1e1e38;
    border: 1px solid #2e2e50;
    border-radius: 6px;
    padding: 4px 8px;
    color: #e0e0f0;
    font-size: 9pt;
}
