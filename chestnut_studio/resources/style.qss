/* Chestnut Studio — 简洁青春主题
 *
 * 设计原则：干净、轻量、呼吸感
 * 色彩：柔和深色底 + 粉紫强调色 + 大面积留白
 * 按钮：正常平板按钮，无过度装饰
 * 圆角：统一 8px 大圆角，亲和力强
 *
 * 颜色使用双花括号占位符（如 bg_base），由 utils/theme.py 渲染
 */

/* ── 全局 ── */
* {
    font-family: "Microsoft YaHei", "Segoe UI", -apple-system, sans-serif;
}

QWidget {
    background: {{bg_base}};
    color: {{text_primary}};
    font-size: 9pt;
}

QMainWindow {
    background: {{bg_base}};
}

/* ── 菜单栏 ── */
QMenuBar {
    background: {{bg_dark}};
    border-bottom: 1px solid {{border_subtle}};
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 12px;
    color: {{text_muted}};
    border-radius: 4px;
}

QMenuBar::item:selected {
    background: {{overlay_hover}};
    color: {{text_on_accent}};
}

QMenu {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    color: {{text_secondary}};
    border-radius: 4px;
}

QMenu::item:selected {
    background: {{accent}};
    color: {{text_on_accent}};
}

QMenu::separator {
    height: 1px;
    background: {{border_default}};
    margin: 4px 10px;
}

/* ── 状态栏 ── */
QStatusBar {
    background: {{bg_dark}};
    border-top: 1px solid {{border_subtle}};
    color: {{text_tertiary}};
    font-size: 8pt;
    padding: 1px 4px;
}

QStatusBar::item {
    border: none;
}

#versionLabel {
    color: {{text_dim}};
    font-size: 8pt;
    padding: 0 4px;
    background: transparent;
}

#versionLabel:hover {
    color: {{version_hover}};
}

/* ── 分割条 ── */
QSplitter::handle {
    background: {{border_subtle}};
}

QSplitter::handle:horizontal {
    width: 2px;
}

/* ── 播放器区域 ── */
#playerCard {
    background: {{bg_video}};
}

#videoHint {
    color: {{text_very_dim}};
    font-size: 11pt;
    background: transparent;
}

/* ── 播放控制栏 ── */
#playerControls {
    background: {{bg_card}};
    border-top: 1px solid {{border_subtle}};
}

#playerControls QPushButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 4px;
    min-width: 30px;
    min-height: 30px;
}

#playerControls QPushButton:hover {
    background: {{overlay_hover}};
}

#playerControls QPushButton:pressed {
    background: {{overlay_pressed}};
}

#playBtn {
    min-width: 32px;
    min-height: 32px;
}

#playBtn:hover {
    background: {{overlay_accent_light}};
}

#currentTime, #totalTime {
    color: {{text_time}};
    font-size: 10pt;
    font-weight: 500;
    background: transparent;
    letter-spacing: 0.3px;
}

/* 进度条 */
#seekSlider::groove:horizontal {
    background: {{border_default}};
    height: 4px;
    border-radius: 2px;
}

#seekSlider::handle:horizontal {
    background: {{accent}};
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

#seekSlider::handle:horizontal:hover {
    background: {{accent_hover}};
}

#seekSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: 2px;
}

/* 音量滑块 */
#volumeSlider::groove:horizontal {
    background: {{border_default}};
    height: 4px;
    border-radius: 2px;
}

#volumeSlider::handle:horizontal {
    background: {{text_primary}};
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

#volumeSlider::handle:horizontal:hover {
    background: {{accent}};
}

#volumeSlider::sub-page:horizontal {
    background: {{accent}};
    border-radius: 2px;
}

/* 倍速下拉框 */
#rateCombo {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 6px;
    padding: 2px 8px;
    color: {{text_muted}};
    font-size: 9pt;
    min-height: 26px;
}

#rateCombo:hover {
    border-color: {{accent}};
    color: {{text_on_accent}};
}

#rateCombo::drop-down {
    border: none;
    width: 14px;
}

#rateCombo QAbstractItemView {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
    selection-background-color: {{accent}};
    selection-color: {{text_on_accent}};
    color: {{text_secondary}};
    padding: 4px;
    outline: none;
}

/* ── 左侧面板（播放器 + 输入栏） ── */
#leftPane {
    background: transparent;
}

/* ── 输入栏 ── */
#inputBar {
    background: {{bg_card}};
    border-top: 1px solid {{border_subtle}};
}

#colorDot {
    min-width: 10px;
    min-height: 10px;
    max-width: 10px;
    max-height: 10px;
    border-radius: 5px;
}

#trackLabel {
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
}

#noteInput {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
    padding: 7px 14px;
    color: {{text_primary}};
    font-size: 10pt;
    min-height: 20px;
    selection-background-color: {{accent}};
}

#noteInput:focus {
    border-color: {{accent}};
}

#noteInput::placeholder {
    color: {{text_dim}};
}

#timeLabel {
    color: {{accent}};
    font-size: 10pt;
    font-weight: 600;
    background: transparent;
    padding: 0 4px;
}

#sendBtn {
    background: {{accent}};
    color: {{text_on_accent}};
    border: none;
    border-radius: 8px;
    padding: 6px 18px;
    font-size: 10pt;
    font-weight: 500;
    min-height: 30px;
}

#sendBtn:hover {
    background: {{accent_hover}};
}

#sendBtn:pressed {
    background: {{accent_pressed}};
}

/* ── 笔记列表面板 ── */
#notePanel {
    background: {{bg_card}};
    border-left: 2px solid {{border_subtle}};
}

#notePanelTitle {
    background: {{bg_dark}};
    border-bottom: 1px solid {{border_subtle}};
    padding: 10px 14px;
}

#notePanelTitleText {
    color: {{text_primary}};
    font-size: 11pt;
    font-weight: 600;
    background: transparent;
}

#notePanelCount {
    color: {{text_tertiary}};
    font-size: 8pt;
    background: {{border_subtle}};
    border-radius: 8px;
    padding: 1px 7px;
    min-width: 14px;
}

#clearBtn {
    background: transparent;
    border: 1px solid {{border_default}};
    border-radius: 6px;
    color: {{text_tertiary}};
    font-size: 8pt;
    padding: 3px 10px;
    min-height: 22px;
}

#clearBtn:hover {
    border-color: {{danger}};
    color: {{danger}};
}

/* 笔记列表 */
#noteList {
    background: transparent;
    border: none;
    outline: none;
}

#noteList::item {
    background: transparent;
    border: none;
    border-bottom: 1px solid {{overlay_item_border}};
    padding: 2px 0;
}

#noteList::item:selected {
    background: {{overlay_selected}};
}

#noteList::item:hover {
    background: {{overlay_item}};
}

#noteGroupLabel {
    font-size: 8pt;
    font-weight: 600;
    background: transparent;
    padding: 6px 14px 2px;
    letter-spacing: 1px;
}

#noteId {
    color: {{text_dim}};
    font-size: 8pt;
    font-weight: 500;
    background: transparent;
}

#noteTime {
    color: {{accent}};
    font-size: 9pt;
    font-weight: 600;
    background: transparent;
}

#noteText {
    color: {{text_secondary}};
    font-size: 9pt;
    background: transparent;
    line-height: 1.3;
}

#noteEmptyLabel {
    color: {{text_dim}};
    font-size: 10pt;
    background: transparent;
    padding: 32px 16px;
}

/* ── 滚动条 ── */
QScrollBar:vertical {
    background: transparent;
    width: 5px;
    border: none;
}

QScrollBar::handle:vertical {
    background: {{scrollbar_handle}};
    min-height: 24px;
    border-radius: 2.5px;
}

QScrollBar::handle:vertical:hover {
    background: {{scrollbar_hover}};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* ── 数据表格对话框（快捷键 / 术语表） ── */
#shortcutDialog, #termTableDialog {
    background: {{bg_base}};
}

#shortcutDialog QTableWidget, #termTableDialog QTableWidget {
    background: {{bg_base}};
    border: none;
    color: {{text_primary}};
    font-size: 10pt;
    outline: none;
}

#shortcutDialog QTableWidget::item, #termTableDialog QTableWidget::item {
    padding: 6px 12px;
    border: none;
}

#shortcutDialog QTableWidget::item:selected, #termTableDialog QTableWidget::item:selected {
    background: {{overlay_accent_light}};
}

#shortcutDialog QHeaderView::section, #termTableDialog QHeaderView::section {
    background: {{bg_dark}};
    border: none;
    border-bottom: 1px solid {{border_subtle}};
    padding: 8px 12px;
    color: {{text_muted}};
    font-weight: 600;
}

/* ── 工具提示 ── */
QToolTip {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 6px;
    padding: 4px 8px;
    color: {{text_primary}};
    font-size: 9pt;
}

/* ── 合并对话框 ── */
MergeDialog {
    background: {{bg_base}};
}

QLabel#pathLabel {
    color: {{text_secondary}};
    padding: 6px 10px;
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
    min-height: 20px;
}

QLabel#fileLabel {
    color: {{text_muted}};
    font-size: 9pt;
}

QPushButton#browseBtn {
    background: transparent;
    border: 1px solid {{border_default}};
    border-radius: 8px;
    padding: 6px 14px;
    color: {{text_secondary}};
    font-size: 9pt;
    min-height: 20px;
}

QPushButton#browseBtn:hover {
    border-color: {{accent}};
    color: {{text_on_accent}};
}

QPushButton#primaryBtn {
    background: {{accent}};
    border: none;
    border-radius: 8px;
    padding: 8px 28px;
    color: {{text_on_accent}};
    font-size: 10pt;
    font-weight: 600;
    min-height: 26px;
}

QPushButton#primaryBtn:hover {
    background: {{accent_hover}};
}

QPushButton#primaryBtn:pressed {
    background: {{accent_pressed}};
}

QPushButton#primaryBtn:disabled {
    background: {{border_default}};
    color: {{text_dim}};
}

QLabel#statsLabel {
    color: {{text_secondary}};
    padding: 6px 10px;
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
}

QTextEdit#reportView {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    color: {{text_secondary}};
    background: {{bg_dark}};
    border: 1px solid {{border_default}};
    border-radius: 8px;
    padding: 8px;
}

/* ── 术语编辑对话框 ── */
#termEditDialog {
    background: {{bg_base}};
}

#termEditDialog QLineEdit {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 6px;
    padding: 5px 10px;
    color: {{text_primary}};
    min-height: 22px;
}

#termEditDialog QLineEdit:focus {
    border-color: {{accent}};
}

#termEditDialog QTextEdit {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 6px;
    padding: 5px 10px;
    color: {{text_primary}};
}

#termEditDialog QTextEdit:focus {
    border-color: {{accent}};
}

#termEditDialog QLabel {
    color: {{text_secondary}};
    font-size: 9pt;
}

/* ── 百宝箱对话框 ── */
#debugBox {
    background: {{bg_base}};
}

#debugBox QGroupBox {
    color: {{text_primary}};
    font-weight: 600;
    border: 1px solid {{border_default}};
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 16px;
}

#debugBox QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

#debugBox QPushButton {
    background: {{bg_surface}};
    border: 1px solid {{border_default}};
    border-radius: 6px;
    padding: 5px 14px;
    color: {{text_secondary}};
    min-height: 22px;
}

#debugBox QPushButton:hover {
    border-color: {{accent}};
    color: {{text_on_accent}};
}

#debugBox QLabel {
    color: {{text_muted}};
    font-size: 9pt;
}

/* ── 排序/术语按钮 ── */
#sortBtn, #termBtn {
    background: transparent;
    border: 1px solid {{border_default}};
    border-radius: 6px;
    color: {{text_muted}};
    font-size: 8pt;
    padding: 2px 8px;
    min-height: 20px;
}

#sortBtn:hover, #termBtn:hover {
    border-color: {{accent}};
    color: {{text_on_accent}};
}

/* ── 焦点指示器（键盘导航可访问性） ── */
/* 通用焦点轮廓 — 白色半透明，不干扰按钮自身 hover/active 色彩 */
QPushButton:focus {
    outline: 2px solid rgba(255, 255, 255, 0.3);
    outline-offset: 1px;
}

/* 实色背景按钮用更亮轮廓，确保可见 */
#sendBtn:focus, #primaryBtn:focus {
    outline-color: rgba(255, 255, 255, 0.6);
}

/* 列表焦点 */
#noteList:focus {
    outline: 1px solid rgba(255, 255, 255, 0.2);
    outline-offset: -1px;
}

/* 下拉框 focus */
#rateCombo:focus {
    border-color: rgba(255, 255, 255, 0.3);
}